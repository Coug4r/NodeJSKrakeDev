generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model usuarios {
  id       Int     @id @default(autoincrement())
  password String  @db.VarChar(100)
  rol      String? @db.VarChar(20)
  username String  @unique(map: "ukm2dvbwfge291euvmk6vkkocao") @db.VarChar(50)
}
model vehiculos {
  id        Int     @id @default(autoincrement())
  foto      Bytes?
  marca     String  @db.VarChar(255)
  mime_type String @db.VarChar(255)
  modelo    String  @db.VarChar(255)
}
